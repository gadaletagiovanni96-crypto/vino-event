@startuml
left to right direction
actor Utente
actor Fornitore
actor Operatore
actor Amministratore

rectangle "Calici & Colline" {
  usecase "Consultare info evento" as UC0
  usecase "Registrarsi / Accedere (Passport)" as UC1
  usecase "Aggiungere biglietti al carrello" as UC2
  usecase "Pagare (carta simulata)" as UC3
  usecase "Consultare biglietti in bacheca" as UC4
  usecase "Ricevere biglietti via email" as UC5
  usecase "Consultare tipologie di stand" as UC6
  usecase "Acquistare uno stand" as UC7
  usecase "Chattare con l'amministratore" as UC8
  usecase "Scansionare QR code" as UC9
  usecase "Vedere dati dell'acquirente" as UC10
  usecase "Convalidare l'ingresso" as UC11
  usecase "Aprire/chiudere le vendite" as UC12
  usecase "Impostare numero biglietti vendibili" as UC13
  usecase "Consultare contabilità, stand e biglietti (real-time)" as UC14
  usecase "Rispondere ai fornitori in chat" as UC15
}
Utente --> UC0
Utente --> UC1
Utente --> UC2
Utente --> UC4
UC2 ..> UC3 : <<include>>
UC3 ..> UC5 : <<include>>
Fornitore --> UC1
Fornitore --> UC6
Fornitore --> UC7
Fornitore --> UC8
UC7 ..> UC3 : <<include>>
Operatore --> UC1
Operatore --> UC9
UC9 ..> UC10 : <<include>>
UC9 ..> UC11 : <<extend>>
Amministratore --> UC1
Amministratore --> UC12
Amministratore --> UC13
Amministratore --> UC14
Amministratore --> UC15
UC8 .. UC15
@enduml
